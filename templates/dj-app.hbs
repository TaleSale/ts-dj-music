<div class="ts-dj-music-app">
  <section class="ts-dj-toolbar">
    <div class="ts-dj-live-rate">
      <div class="ts-dj-live-control-row">
        <label>{{localize "TS_DJ_MUSIC.App.LiveSpeed"}}</label>
        <input type="range" min="0.5" max="2" step="0.25" value="{{liveRate}}" data-action="set-live-rate">
        <span class="ts-dj-live-rate-value ts-dj-live-control-value">{{liveRateLabel}}</span>
      </div>
      <div class="ts-dj-live-control-row">
        <label>{{localize "TS_DJ_MUSIC.App.LiveMusicVolume"}}</label>
        <input type="range" min="0" max="1" step="0.05" value="{{liveMusicVolume}}" data-action="set-live-music-volume">
        <span class="ts-dj-live-music-volume-value ts-dj-live-control-value">{{liveMusicVolumeLabel}}</span>
      </div>
      <div class="ts-dj-live-control-row">
        <label>{{localize "TS_DJ_MUSIC.App.LiveAmbienceVolume"}}</label>
        <input type="range" min="0" max="1" step="0.05" value="{{liveAmbienceVolume}}" data-action="set-live-ambience-volume">
        <span class="ts-dj-live-ambience-volume-value ts-dj-live-control-value">{{liveAmbienceVolumeLabel}}</span>
      </div>
    </div>
    <div class="ts-dj-status ts-dj-toolbar-side">
      <div class="ts-dj-settings-actions ts-dj-toolbar-actions">
        <button type="button" data-action="import-settings"><i class="fas fa-file-import"></i> {{localize "TS_DJ_MUSIC.Common.Import"}}</button>
        <button type="button" data-action="export-settings"><i class="fas fa-file-export"></i> {{localize "TS_DJ_MUSIC.Common.Export"}}</button>
        <button type="button" class="ts-dj-icon-button" data-action="reset-module-settings" title="{{localize "TS_DJ_MUSIC.Dialogs.ResetSettingsTitle"}}" aria-label="{{localize "TS_DJ_MUSIC.Dialogs.ResetSettingsTitle"}}"><i class="fas fa-trash"></i></button>
      </div>
      <label class="ts-dj-ambience-toggle ts-dj-toolbar-toggle">
        <input type="checkbox" data-action="set-ambience-concurrency" {{#if ambienceAllowConcurrent}}checked{{/if}}>
        {{localize "TS_DJ_MUSIC.App.AllowMultipleAmbience"}}
      </label>
    </div>
    <details class="ts-dj-card ts-dj-card-collapse ts-dj-now-playing-card" data-card-key="nowPlaying" {{#if managerCards.nowPlaying.expanded}}open{{/if}}>
      <summary>
        <span class="ts-dj-card-summary-label">{{nowPlayingTitle}}</span>
      </summary>
      <div class="ts-dj-card-content">
        <article class="ts-dj-now-playing {{#if nowPlaying.active}}is-active{{else}}is-idle{{/if}}" data-now-playing>
          <header class="ts-dj-now-playing-header">
            <div class="ts-dj-now-playing-heading">
              <span class="ts-dj-now-playing-kicker">{{nowPlayingTitle}}</span>
              <strong data-now-playing-title>{{nowPlaying.title}}</strong>
              <span class="ts-dj-now-playing-summary" data-now-playing-summary>{{nowPlaying.summary}}</span>
            </div>
            <div class="ts-dj-now-playing-actions">
              <span class="ts-dj-now-playing-state" data-now-playing-state>{{nowPlaying.stateLabel}}</span>
              {{#if isPlaying}}
              <button type="button" class="ts-dj-icon-button" data-action="stop" title="{{localize "TS_DJ_MUSIC.Common.Stop"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Stop"}}"><i class="fas fa-stop"></i></button>
              {{/if}}
            </div>
          </header>
          <div class="ts-dj-now-playing-context" data-now-playing-context>{{nowPlaying.context}}</div>
          <div class="ts-dj-now-playing-source">
            <span class="ts-dj-now-playing-meta-label">{{nowPlayingSourceTitle}}</span>
            <strong data-now-playing-source-name>{{nowPlaying.sourceName}}</strong>
            <span data-now-playing-source-path>{{nowPlaying.sourcePath}}</span>
          </div>
          <div class="ts-dj-now-playing-stats">
            <div class="ts-dj-now-playing-stat">
              <span class="ts-dj-now-playing-meta-label">{{nowPlayingVolumesTitle}}</span>
              <strong data-now-playing-volume-primary>{{nowPlaying.volumePrimary}}</strong>
              <span data-now-playing-volume-secondary>{{nowPlaying.volumeSecondary}}</span>
            </div>
            <div class="ts-dj-now-playing-stat">
              <span class="ts-dj-now-playing-meta-label">{{nowPlayingHertzTitle}}</span>
              <strong data-now-playing-hertz-primary>{{nowPlaying.hertzPrimary}}</strong>
              <span data-now-playing-hertz-secondary>{{nowPlaying.hertzSecondary}}</span>
            </div>
            <div class="ts-dj-now-playing-stat">
              <span class="ts-dj-now-playing-meta-label">{{nowPlayingSpeedsTitle}}</span>
              <strong data-now-playing-speed-primary>{{nowPlaying.speedPrimary}}</strong>
              <span data-now-playing-speed-secondary>{{nowPlaying.speedSecondary}}</span>
            </div>
            <div class="ts-dj-now-playing-stat">
              <span class="ts-dj-now-playing-meta-label">{{nowPlayingClipTitle}}</span>
              <strong data-now-playing-clip>{{nowPlaying.clipLabel}}</strong>
            </div>
          </div>
          <div class="ts-dj-now-playing-progress">
            <div class="ts-dj-now-playing-progress-head">
              <span class="ts-dj-now-playing-meta-label">{{nowPlayingProgressTitle}}</span>
              <strong data-now-playing-progress-label>{{nowPlaying.progressLabel}}</strong>
            </div>
            <div class="ts-dj-now-playing-progress-bar {{#if nowPlaying.canSeek}}is-seekable{{/if}}" data-now-playing-progress-bar>
              <span class="ts-dj-now-playing-progress-fill" data-now-playing-progress-fill style="width: {{nowPlaying.progressPercent}}%;"></span>
            </div>
          </div>
        </article>
      </div>
    </details>
  </section>

  <section class="ts-dj-sections">
    <details class="ts-dj-section" data-section="normalization" {{#if managerSections.normalization}}open{{/if}}>
      <summary>{{normalizationSectionTitle}}</summary>
      <div class="ts-dj-section-body">
        <article class="ts-dj-card">
          <header class="ts-dj-card-static-header">
            <span class="ts-dj-card-summary-label">{{normalizationSectionTitle}}</span>
          </header>
          <div class="ts-dj-section-body ts-dj-normalization-block">
            <div class="ts-dj-normalization-channel">
              <div class="ts-dj-normalization-row" style="display:grid;grid-template-columns:max-content minmax(0,1fr) auto;align-items:center;column-gap:6px;row-gap:8px;">
                <label class="ts-dj-normalization-label" data-normalization-label="music">{{musicAutoLevelLabel}}</label>
                <span class="ts-dj-live-monitor-value" data-normalization-monitor="music">{{musicAutoLevelMonitor}}</span>
                <div class="ts-dj-normalization-input-block" style="display:inline-flex;align-items:center;gap:6px;">
                  <input type="text" value="{{musicNormalizationInputValue}}" placeholder="1000" inputmode="decimal" autocomplete="off" data-normalization-input="music">
                  <span class="ts-dj-live-normalization-unit">mHz</span>
                </div>
              </div>
              <div class="ts-dj-live-monitor-actions ts-dj-live-monitor-actions--stacked">
                <button type="button" data-action="apply-manual-normalization" data-channel="music">{{normalizationSetLabel}}</button>
                <button type="button" data-action="reset-manual-normalization" data-channel="music">{{normalizationResetLabel}}</button>
              </div>
              <div class="ts-dj-live-monitor-actions ts-dj-live-monitor-actions--stacked ts-dj-normalization-scan-actions">
                {{#each musicNormalizationScanButtons}}
                <button type="button" data-action="scan-normalization-tracks" data-channel="music" data-normalization-scan-button="music" data-normalization-scan-profile="{{mode}}" {{#if disabled}}disabled{{/if}}>{{label}}</button>
                {{/each}}
              </div>
            </div>
            <div class="ts-dj-normalization-channel">
              <div class="ts-dj-normalization-row" style="display:grid;grid-template-columns:max-content minmax(0,1fr) auto;align-items:center;column-gap:6px;row-gap:8px;">
                <label class="ts-dj-normalization-label" data-normalization-label="ambience">{{ambienceAutoLevelLabel}}</label>
                <span class="ts-dj-live-monitor-value" data-normalization-monitor="ambience">{{ambienceAutoLevelMonitor}}</span>
                <div class="ts-dj-normalization-input-block" style="display:inline-flex;align-items:center;gap:6px;">
                  <input type="text" value="{{ambienceNormalizationInputValue}}" placeholder="1000" inputmode="decimal" autocomplete="off" data-normalization-input="ambience">
                  <span class="ts-dj-live-normalization-unit">mHz</span>
                </div>
              </div>
              <div class="ts-dj-live-monitor-actions ts-dj-live-monitor-actions--stacked">
                <button type="button" data-action="apply-manual-normalization" data-channel="ambience">{{normalizationSetLabel}}</button>
                <button type="button" data-action="reset-manual-normalization" data-channel="ambience">{{normalizationResetLabel}}</button>
              </div>
              <div class="ts-dj-live-monitor-actions ts-dj-live-monitor-actions--stacked ts-dj-normalization-scan-actions">
                {{#each ambienceNormalizationScanButtons}}
                <button type="button" data-action="scan-normalization-tracks" data-channel="ambience" data-normalization-scan-button="ambience" data-normalization-scan-profile="{{mode}}" {{#if disabled}}disabled{{/if}}>{{label}}</button>
                {{/each}}
              </div>
            </div>
          </div>
        </article>
      </div>
    </details>

    <details class="ts-dj-section" data-section="files" {{#if managerSections.files}}open{{/if}}>
      <summary>{{localize "TS_DJ_MUSIC.Common.Files"}}</summary>
      <div class="ts-dj-section-body">
        <article class="ts-dj-card" data-card="files">
          <header class="ts-dj-card-static-header">
            <span class="ts-dj-card-summary-label">{{localize "TS_DJ_MUSIC.Common.Files"}}</span>
            <div class="ts-dj-card-actions">
              <button type="button" data-action="create-file"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
              <button type="button" class="ts-dj-icon-button" data-action="delete-files-block" title="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllFilesTitle"}}" aria-label="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllFilesTitle"}}"><i class="fas fa-trash"></i></button>
            </div>
          </header>
          <div class="ts-dj-list">
            {{#if hasFiles}}
              {{#each files}}
              <div class="ts-dj-row">
                <div class="ts-dj-row-main">
                  <strong>{{name}}</strong>
                  <div class="meta">{{localize "TS_DJ_MUSIC.Common.Path"}}: {{path}}</div>
                </div>
                <div class="ts-dj-actions">
                  <button type="button" class="ts-dj-text-action" data-action="create-tracks-from-file" data-id="{{id}}" title="Создать треки из списка" aria-label="Создать треки из списка">+♫</button>
                  <button type="button" data-action="edit-file" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                  <button type="button" data-action="delete-file" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              {{/each}}
            {{else}}
              <p class="notes">{{localize "TS_DJ_MUSIC.Notes.NoFilesYet"}}</p>
            {{/if}}
          </div>
        </article>
      </div>
    </details>

    <details class="ts-dj-section" data-section="music" {{#if managerSections.music}}open{{/if}}>
      <summary>{{localize "TS_DJ_MUSIC.Common.Music"}}</summary>
      <div class="ts-dj-section-body">
        <div class="ts-dj-grid ts-dj-grid-music">
          <details class="ts-dj-card ts-dj-card-collapse" data-card="music-playlists" data-card-key="musicPlaylists" {{#if managerCards.musicPlaylists.expanded}}open{{/if}}>
            <summary>
              <span class="ts-dj-card-summary-label">{{localize "TS_DJ_MUSIC.Common.Playlists"}}</span>
            </summary>
            <div class="ts-dj-card-actions">
              <button type="button" data-action="create-playlist"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
              <button type="button" data-action="transfer-playlist"><i class="fas fa-right-left"></i> {{localize "TS_DJ_MUSIC.Common.ImportExport"}}</button>
              <button type="button" class="ts-dj-icon-button" data-action="delete-playlists-block" title="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllPlaylistsTitle"}}" aria-label="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllPlaylistsTitle"}}"><i class="fas fa-trash"></i></button>
            </div>
            <div class="ts-dj-card-content">
              <div class="ts-dj-card-content-inner">
                <div class="ts-dj-list">
                  {{#if hasPlaylists}}
                    {{#each playlists}}
                    <div class="ts-dj-manager-playlist" data-playlist-id="{{id}}">
                      <div class="ts-dj-music-sidebar-playlist">
                        <div class="ts-dj-music-sidebar-row {{#if active}}is-active{{/if}}">
                          <div class="row-actions">
                            <button type="button" data-action="{{playAction}}" data-id="{{id}}" class="play"><i class="fas {{playIcon}}"></i></button>
                            <button type="button" data-action="toggle-playlist-loop" data-id="{{id}}" class="loop {{#if loop}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Loop"}}"><i class="fas fa-repeat"></i></button>
                            <button type="button" data-action="toggle-playlist-shuffle" data-id="{{id}}" class="shuffle {{#if shuffle}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Shuffle"}}"><i class="fas fa-random"></i></button>
                            <button type="button" data-action="choose-playlist-normalization-scan" data-channel="music" data-playlist-id="{{id}}" data-normalization-playlist-scan-trigger="music" class="scan" title="{{localize "TS_DJ_MUSIC.Common.Normalization"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Normalization"}}" {{#if normalizationScanDisabled}}disabled{{/if}}><i class="fas fa-magnifying-glass"></i></button>
                            <button type="button" data-action="edit-playlist" data-id="{{id}}" class="edit" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                            <button type="button" data-action="delete-playlist" data-id="{{id}}" class="delete" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                            <button type="button" data-action="{{expandAction}}" data-id="{{id}}" class="expand {{#if expanded}}is-on{{/if}}" title="{{expandTitle}}"><i class="fas {{expandIcon}}"></i></button>
                          </div>
                          <div class="meta">
                            <strong>{{name}}</strong>
                            <span>{{trackCount}} {{localize "TS_DJ_MUSIC.Common.TracksLower"}} | {{localize "TS_DJ_MUSIC.Common.LoopLower"}}: {{#if loop}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}} | {{localize "TS_DJ_MUSIC.Common.ShuffleLower"}}: {{#if shuffle}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}}</span>
                          </div>
                        </div>
                        <div class="ts-dj-music-sidebar-sublist {{#if expanded}}is-open{{/if}}">
                          {{#each trackEntries}}
                          <div class="ts-dj-music-sidebar-subrow {{#if active}}is-active{{/if}}" data-manager-playlist-track-row data-playlist-kind="music" data-playlist-id="{{playlistId}}" data-track-id="{{id}}" draggable="true" title="{{localize "TS_DJ_MUSIC.Common.DragToReorder"}}">
                            <button
                              type="button"
                              data-action="{{playAction}}"
                              data-id="{{id}}"
                              data-playlist-id="{{playlistId}}"
                              data-track-id="{{id}}"
                              class="play-from-track"
                              title="{{localize "TS_DJ_MUSIC.Common.PlayFromTrack"}}"
                            ><i class="fas {{playIcon}}"></i></button>
                            <span class="index">{{index}}.</span>
                            <span class="track-name">{{name}}</span>
                          </div>
                          {{/each}}
                          {{#unless trackEntries.length}}
                          <div class="ts-dj-music-sidebar-subrow is-empty">{{localize "TS_DJ_MUSIC.Notes.NoTracksAvailable"}}</div>
                          {{/unless}}
                        </div>
                      </div>
                    </div>
                    {{/each}}
                  {{else}}
                    <p class="notes">{{localize "TS_DJ_MUSIC.Notes.NoPlaylistsYet"}}</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </details>

          <details class="ts-dj-card ts-dj-card-collapse" data-card="music-tracks" data-card-key="musicTracks" {{#if managerCards.musicTracks.expanded}}open{{/if}}>
            <summary>
              <span class="ts-dj-card-summary-label">{{localize "TS_DJ_MUSIC.Common.Music"}}</span>
            </summary>
            <div class="ts-dj-card-actions">
              <button type="button" data-action="create-track"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
              <button type="button" data-action="create-track-folder"><i class="fas fa-folder-plus"></i> {{localize "TS_DJ_MUSIC.Common.NewFolder"}}</button>
              <button type="button" class="ts-dj-icon-button" data-action="delete-tracks-block" title="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllMusicTitle"}}" aria-label="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllMusicTitle"}}"><i class="fas fa-trash"></i></button>
            </div>
            <div class="ts-dj-card-content">
              <div class="ts-dj-card-content-inner">
                <div class="ts-dj-list">
                  {{#if hasTrackGroups}}
                    <section class="ts-dj-track-folder ts-dj-track-folder-root {{#if musicRootCollapsed}}is-collapsed{{/if}}" data-manager-track-drop-zone data-track-kind="music" data-folder-id="">
                      <header class="ts-dj-track-folder-head">
                        <button type="button" class="ts-dj-icon-button" data-action="toggle-track-root-folder" title="{{#if musicRootCollapsed}}{{localize "TS_DJ_MUSIC.Common.ShowFolder"}}{{else}}{{localize "TS_DJ_MUSIC.Common.HideFolder"}}{{/if}}"><i class="fas {{#if musicRootCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
                        <strong>{{musicRootName}}</strong>
                        <span>{{musicRootTrackCount}} {{localize "TS_DJ_MUSIC.Common.TracksLower"}}</span>
                        <div class="ts-dj-card-actions">
                          <button type="button" class="ts-dj-icon-button" data-action="edit-track-root-folder" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                        </div>
                      </header>
                      <div class="ts-dj-track-folder-body">
                        {{#each looseTracks}}
                        <div class="ts-dj-row {{#if active}}is-active{{/if}}" data-manager-track-row data-track-kind="music" data-track-id="{{id}}" draggable="{{#if draggable}}true{{else}}false{{/if}}">
                          <div class="ts-dj-row-main">
                            <strong>{{name}}</strong>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.File"}}: {{fileName}}</div>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.Clip"}}: {{startLabel}} - {{endLabel}} | {{localize "TS_DJ_MUSIC.Common.Speed"}}: {{rateLabel}} | {{normalizeTitle}}: {{normalizeLabel}} | {{localize "TS_DJ_MUSIC.Common.Loop"}}: {{#if loop}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}}</div>
                          </div>
                          <div class="ts-dj-actions">
                            <button type="button" class="ts-dj-play-toggle" data-action="{{playAction}}" data-id="{{id}}"><i class="fas {{playIcon}}"></i></button>
                            <button type="button" data-action="toggle-track-loop" data-id="{{id}}" class="loop {{#if loop}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Loop"}}"><i class="fas fa-repeat"></i></button>
                            <button type="button" data-action="edit-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                            <button type="button" data-action="delete-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                          </div>
                        </div>
                        {{/each}}
                        {{#unless looseTracks.length}}
                        <div class="ts-dj-row ts-dj-row-empty">{{localize "TS_DJ_MUSIC.Common.DropTracksHere"}}</div>
                        {{/unless}}
                      </div>
                    </section>
                    {{#each trackFolders}}
                    <section class="ts-dj-track-folder {{#if collapsed}}is-collapsed{{/if}}" data-manager-track-drop-zone data-track-kind="music" data-folder-id="{{id}}">
                      <header class="ts-dj-track-folder-head">
                        <button type="button" class="ts-dj-icon-button" data-action="toggle-track-folder" data-id="{{id}}" title="{{#if collapsed}}{{localize "TS_DJ_MUSIC.Common.ShowFolder"}}{{else}}{{localize "TS_DJ_MUSIC.Common.HideFolder"}}{{/if}}"><i class="fas {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
                        <strong>{{name}}</strong>
                        <span>{{trackCount}} {{localize "TS_DJ_MUSIC.Common.TracksLower"}}</span>
                        <div class="ts-dj-card-actions">
                          <button type="button" data-action="create-track" data-folder-id="{{id}}"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
                          <button type="button" class="ts-dj-icon-button" data-action="edit-track-folder" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                          <button type="button" class="ts-dj-icon-button" data-action="delete-track-folder" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                        </div>
                      </header>
                      <div class="ts-dj-track-folder-body">
                        {{#each trackEntries}}
                        <div class="ts-dj-row {{#if active}}is-active{{/if}}" data-manager-track-row data-track-kind="music" data-track-id="{{id}}" draggable="{{#if draggable}}true{{else}}false{{/if}}">
                          <div class="ts-dj-row-main">
                            <strong>{{name}}</strong>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.File"}}: {{fileName}}</div>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.Clip"}}: {{startLabel}} - {{endLabel}} | {{localize "TS_DJ_MUSIC.Common.Speed"}}: {{rateLabel}} | {{normalizeTitle}}: {{normalizeLabel}} | {{localize "TS_DJ_MUSIC.Common.Loop"}}: {{#if loop}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}}</div>
                          </div>
                          <div class="ts-dj-actions">
                            <button type="button" class="ts-dj-play-toggle" data-action="{{playAction}}" data-id="{{id}}"><i class="fas {{playIcon}}"></i></button>
                            <button type="button" data-action="toggle-track-loop" data-id="{{id}}" class="loop {{#if loop}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Loop"}}"><i class="fas fa-repeat"></i></button>
                            <button type="button" data-action="edit-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                            <button type="button" data-action="delete-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                          </div>
                        </div>
                        {{/each}}
                        {{#unless hasTracks}}
                        <div class="ts-dj-row ts-dj-row-empty">{{localize "TS_DJ_MUSIC.Common.DropTracksHere"}}</div>
                        {{/unless}}
                      </div>
                    </section>
                    {{/each}}
                  {{else}}
                    <p class="notes">{{localize "TS_DJ_MUSIC.Notes.NoTracksYet"}}</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </details>
        </div>
      </div>
    </details>

    <details class="ts-dj-section" data-section="ambience" {{#if managerSections.ambience}}open{{/if}}>
      <summary>{{localize "TS_DJ_MUSIC.Common.Ambience"}}</summary>
      <div class="ts-dj-section-body">
        <div class="ts-dj-grid ts-dj-grid-ambience">
          <details class="ts-dj-card ts-dj-card-collapse" data-card="ambience-playlists" data-card-key="ambiencePlaylists" {{#if managerCards.ambiencePlaylists.expanded}}open{{/if}}>
            <summary>
              <span class="ts-dj-card-summary-label">{{localize "TS_DJ_MUSIC.Common.AmbiencePlaylists"}}</span>
            </summary>
            <div class="ts-dj-card-actions">
              <button type="button" data-action="create-ambience-playlist"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
              <button type="button" class="ts-dj-icon-button" data-action="delete-ambience-playlists-block" title="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllAmbiencePlaylistsTitle"}}" aria-label="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllAmbiencePlaylistsTitle"}}"><i class="fas fa-trash"></i></button>
            </div>
            <div class="ts-dj-card-content">
              <div class="ts-dj-card-content-inner">
                <div class="ts-dj-list">
                  {{#if hasAmbiencePlaylists}}
                    {{#each ambiencePlaylists}}
                    <div class="ts-dj-manager-playlist" data-ambience-playlist-id="{{id}}">
                      <div class="ts-dj-music-sidebar-playlist">
                        <div class="ts-dj-music-sidebar-row {{#if active}}is-active{{/if}}">
                          <div class="row-actions">
                            <button type="button" data-action="{{playAction}}" data-id="{{id}}" class="play"><i class="fas {{playIcon}}"></i></button>
                            <button type="button" data-action="toggle-ambience-playlist-loop" data-id="{{id}}" class="loop {{#if loop}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Loop"}}"><i class="fas fa-repeat"></i></button>
                            <button type="button" data-action="toggle-ambience-playlist-shuffle" data-id="{{id}}" class="shuffle {{#if shuffle}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Shuffle"}}"><i class="fas fa-random"></i></button>
                            <button type="button" data-action="choose-playlist-normalization-scan" data-channel="ambience" data-playlist-id="{{id}}" data-normalization-playlist-scan-trigger="ambience" class="scan" title="{{localize "TS_DJ_MUSIC.Common.Normalization"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Normalization"}}" {{#if normalizationScanDisabled}}disabled{{/if}}><i class="fas fa-magnifying-glass"></i></button>
                            <button type="button" data-action="edit-ambience-playlist" data-id="{{id}}" class="edit" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                            <button type="button" data-action="delete-ambience-playlist" data-id="{{id}}" class="delete" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                            <button type="button" data-action="{{expandAction}}" data-id="{{id}}" class="expand {{#if expanded}}is-on{{/if}}" title="{{expandTitle}}"><i class="fas {{expandIcon}}"></i></button>
                          </div>
                          <div class="meta">
                            <strong>{{name}}</strong>
                            <span>{{trackCount}} {{localize "TS_DJ_MUSIC.Common.TracksLower"}} | {{localize "TS_DJ_MUSIC.Common.LoopLower"}}: {{#if loop}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}} | {{localize "TS_DJ_MUSIC.Common.ShuffleLower"}}: {{#if shuffle}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}}</span>
                          </div>
                        </div>
                        <div class="ts-dj-music-sidebar-sublist {{#if expanded}}is-open{{/if}}" data-manager-playlist-drop-zone data-manager-playlist-track-list data-playlist-kind="ambience" data-playlist-id="{{id}}">
                          {{#each trackEntries}}
                          <div class="ts-dj-music-sidebar-subrow {{#if active}}is-active{{/if}}" data-manager-playlist-track-row data-playlist-kind="ambience" data-playlist-id="{{playlistId}}" data-track-id="{{id}}" draggable="true" title="{{localize "TS_DJ_MUSIC.Common.DragToReorder"}}">
                            <button
                              type="button"
                              data-action="{{playAction}}"
                              data-id="{{id}}"
                              data-playlist-id="{{playlistId}}"
                              data-track-id="{{id}}"
                              class="play-from-track"
                              title="{{localize "TS_DJ_MUSIC.Common.PlayFromTrack"}}"
                            ><i class="fas {{playIcon}}"></i></button>
                            <span class="index">{{index}}.</span>
                            <span class="track-name">{{name}}</span>
                          </div>
                          {{/each}}
                          {{#unless trackEntries.length}}
                          <div class="ts-dj-music-sidebar-subrow is-empty">{{localize "TS_DJ_MUSIC.Notes.NoTracksAvailable"}}</div>
                          {{/unless}}
                        </div>
                      </div>
                    </div>
                    {{/each}}
                  {{else}}
                    <p class="notes">{{localize "TS_DJ_MUSIC.Notes.NoAmbiencePlaylistsYet"}}</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </details>

          <details class="ts-dj-card ts-dj-card-collapse" data-card="ambience-tracks" data-card-key="ambienceTracks" {{#if managerCards.ambienceTracks.expanded}}open{{/if}}>
            <summary>
              <span class="ts-dj-card-summary-label">{{localize "TS_DJ_MUSIC.Common.Ambience"}}</span>
            </summary>
            <div class="ts-dj-card-actions">
              <button type="button" data-action="create-ambience-track"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
              <button type="button" data-action="create-ambience-track-folder"><i class="fas fa-folder-plus"></i> {{localize "TS_DJ_MUSIC.Common.NewFolder"}}</button>
              <button type="button" class="ts-dj-icon-button" data-action="delete-ambience-tracks-block" title="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllAmbienceTracksTitle"}}" aria-label="{{localize "TS_DJ_MUSIC.Dialogs.DeleteAllAmbienceTracksTitle"}}"><i class="fas fa-trash"></i></button>
            </div>
            <div class="ts-dj-card-content">
              <div class="ts-dj-card-content-inner">
                <div class="ts-dj-list">
                  {{#if hasAmbienceTrackGroups}}
                    <section class="ts-dj-track-folder ts-dj-track-folder-root {{#if ambienceRootCollapsed}}is-collapsed{{/if}}" data-manager-track-drop-zone data-track-kind="ambience" data-folder-id="">
                      <header class="ts-dj-track-folder-head">
                        <button type="button" class="ts-dj-icon-button" data-action="toggle-ambience-track-root-folder" title="{{#if ambienceRootCollapsed}}{{localize "TS_DJ_MUSIC.Common.ShowFolder"}}{{else}}{{localize "TS_DJ_MUSIC.Common.HideFolder"}}{{/if}}"><i class="fas {{#if ambienceRootCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
                        <strong>{{ambienceRootName}}</strong>
                        <span>{{ambienceRootTrackCount}} {{localize "TS_DJ_MUSIC.Common.TracksLower"}}</span>
                        <div class="ts-dj-card-actions">
                          <button type="button" class="ts-dj-icon-button" data-action="edit-ambience-track-root-folder" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                        </div>
                      </header>
                      <div class="ts-dj-track-folder-body">
                        {{#each looseAmbienceTracks}}
                        <div class="ts-dj-row {{#if active}}is-active{{/if}}" data-manager-track-row data-track-kind="ambience" data-track-id="{{id}}" draggable="{{#if draggable}}true{{else}}false{{/if}}">
                          <div class="ts-dj-row-main">
                            <strong>{{name}}</strong>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.File"}}: {{fileName}}</div>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.Clip"}}: {{startLabel}} - {{endLabel}} | {{localize "TS_DJ_MUSIC.Common.Speed"}}: {{rateLabel}} | {{normalizeTitle}}: {{normalizeLabel}} | {{localize "TS_DJ_MUSIC.Common.Loop"}}: {{#if loop}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}}</div>
                          </div>
                          <div class="ts-dj-actions">
                            <button type="button" class="ts-dj-play-toggle" data-action="{{playAction}}" data-id="{{id}}"><i class="fas {{playIcon}}"></i></button>
                            <button type="button" data-action="toggle-ambience-track-loop" data-id="{{id}}" class="loop {{#if loop}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Loop"}}"><i class="fas fa-repeat"></i></button>
                            <button type="button" data-action="edit-ambience-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                            <button type="button" data-action="delete-ambience-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                          </div>
                        </div>
                        {{/each}}
                        {{#unless looseAmbienceTracks.length}}
                        <div class="ts-dj-row ts-dj-row-empty">{{localize "TS_DJ_MUSIC.Common.DropTracksHere"}}</div>
                        {{/unless}}
                      </div>
                    </section>
                    {{#each ambienceTrackFolders}}
                    <section class="ts-dj-track-folder {{#if collapsed}}is-collapsed{{/if}}" data-manager-track-drop-zone data-track-kind="ambience" data-folder-id="{{id}}">
                      <header class="ts-dj-track-folder-head">
                        <button type="button" class="ts-dj-icon-button" data-action="toggle-ambience-track-folder" data-id="{{id}}" title="{{#if collapsed}}{{localize "TS_DJ_MUSIC.Common.ShowFolder"}}{{else}}{{localize "TS_DJ_MUSIC.Common.HideFolder"}}{{/if}}"><i class="fas {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
                        <strong>{{name}}</strong>
                        <span>{{trackCount}} {{localize "TS_DJ_MUSIC.Common.TracksLower"}}</span>
                        <div class="ts-dj-card-actions">
                          <button type="button" data-action="create-ambience-track" data-folder-id="{{id}}"><i class="fas fa-plus"></i> {{localize "TS_DJ_MUSIC.Common.New"}}</button>
                          <button type="button" class="ts-dj-icon-button" data-action="edit-ambience-track-folder" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                          <button type="button" class="ts-dj-icon-button" data-action="delete-ambience-track-folder" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                        </div>
                      </header>
                      <div class="ts-dj-track-folder-body">
                        {{#each trackEntries}}
                        <div class="ts-dj-row {{#if active}}is-active{{/if}}" data-manager-track-row data-track-kind="ambience" data-track-id="{{id}}" draggable="{{#if draggable}}true{{else}}false{{/if}}">
                          <div class="ts-dj-row-main">
                            <strong>{{name}}</strong>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.File"}}: {{fileName}}</div>
                            <div class="meta">{{localize "TS_DJ_MUSIC.Common.Clip"}}: {{startLabel}} - {{endLabel}} | {{localize "TS_DJ_MUSIC.Common.Speed"}}: {{rateLabel}} | {{normalizeTitle}}: {{normalizeLabel}} | {{localize "TS_DJ_MUSIC.Common.Loop"}}: {{#if loop}}{{localize "TS_DJ_MUSIC.Common.Yes"}}{{else}}{{localize "TS_DJ_MUSIC.Common.No"}}{{/if}}</div>
                          </div>
                          <div class="ts-dj-actions">
                            <button type="button" class="ts-dj-play-toggle" data-action="{{playAction}}" data-id="{{id}}"><i class="fas {{playIcon}}"></i></button>
                            <button type="button" data-action="toggle-ambience-track-loop" data-id="{{id}}" class="loop {{#if loop}}is-on{{/if}}" title="{{localize "TS_DJ_MUSIC.Common.Loop"}}"><i class="fas fa-repeat"></i></button>
                            <button type="button" data-action="edit-ambience-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Edit"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Edit"}}"><i class="fas fa-pen"></i></button>
                            <button type="button" data-action="delete-ambience-track" data-id="{{id}}" title="{{localize "TS_DJ_MUSIC.Common.Delete"}}" aria-label="{{localize "TS_DJ_MUSIC.Common.Delete"}}"><i class="fas fa-trash"></i></button>
                          </div>
                        </div>
                        {{/each}}
                        {{#unless hasTracks}}
                        <div class="ts-dj-row ts-dj-row-empty">{{localize "TS_DJ_MUSIC.Common.DropTracksHere"}}</div>
                        {{/unless}}
                      </div>
                    </section>
                    {{/each}}
                  {{else}}
                    <p class="notes">{{localize "TS_DJ_MUSIC.Notes.NoAmbienceTracksYet"}}</p>
                  {{/if}}
                </div>
              </div>
            </div>
          </details>
        </div>
      </div>
    </details>
  </section>
</div>
